# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: OpenRouter API key for LLM-based threat detection and cybersecurity forensics
OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps Platform API key. If omitted, demo mode or standard styling is used.
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_SUPABASE_URL: Supabase project URL for live threat classification results
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Supabase public anonymous API key
VITE_SUPABASE_ANON_KEY=""

# InsForge BaaS Database Configuration
# VITE_INSFORGE_URL: InsForge project backend URL
VITE_INSFORGE_URL="https://threatmail.insforge.app"

# VITE_INSFORGE_API_KEY: InsForge project API Key
VITE_INSFORGE_API_KEY="ik_0c0b843d2790eca5ed3bcd90d2c746f8"
