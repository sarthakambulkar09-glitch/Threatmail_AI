rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.uid == userId &&
        data.email is string && data.email.size() <= 256 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidThreatReport(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'subject', 'senderEmail', 'riskScore', 'classification', 'status', 'scannedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId == userId &&
        data.subject is string && data.subject.size() <= 500 &&
        data.senderEmail is string && data.senderEmail.size() <= 256 &&
        data.riskScore is number && data.riskScore >= 0 && data.riskScore <= 100 &&
        data.classification is string && data.classification.size() <= 64 &&
        data.status is string && data.status.size() <= 32 &&
        data.scannedAt is string && data.scannedAt.size() <= 64;
    }

    function isValidChatMessage(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'role', 'model', 'text', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId == userId &&
        data.role in ['user', 'model', 'system'] &&
        data.model is string && data.model.size() <= 128 &&
        data.text is string && data.text.size() <= 30000 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User Threat Reports Subcollection
      match /threatReports/{reportId} {
        allow get: if isOwner(userId) && isValidId(reportId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(reportId) && isValidThreatReport(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(reportId) && isValidThreatReport(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(reportId);
      }

      // User Chat Messages Subcollection
      match /chatMessages/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(messageId) && isValidChatMessage(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(messageId) && isValidChatMessage(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(messageId);
      }
    }
  }
}
